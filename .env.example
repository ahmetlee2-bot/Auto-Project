APP_TAG=latest
FRONTEND_IMAGE=ghcr.io/ahmetlee2-bot/autolister-frontend
API_IMAGE=ghcr.io/ahmetlee2-bot/autolister-api

# Existing local analysis service defaults
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
AUTONOW_DEFAULT_CITY=Hamburg

# Existing application / Supabase backend values
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVER_ONLY
RESEND_API_KEY=CHANGE_ME_SERVER_ONLY
RESEND_FROM_EMAIL=AutoLister <noreply@autolister-app.de>
OTP_PEPPER=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
CORS_ORIGIN=https://autolister-app.de
EBAY_BRIDGE_SHARED_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
RAINFOREST_API_KEY=
# Optional HTTPS 3PL adapter endpoint; the adapter sends only authenticated requests.
LOGISTICS_3PL_API_URL=
LOGISTICS_3PL_API_KEY=
# Tracking conversion provider (mock mode generates local AQ…DE sandbox numbers).
TRACKING_PROVIDER_API_KEY=
TRACKING_PROVIDER_URL=
TRACKING_MOCK_MODE=false
CRON_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
OVERLAY_TOP_LEFT_TEXT=AutoLister
OVERLAY_BOTTOM_RIGHT_TEXT=autolister-app.de
EBAY_APP_ID=
EBAY_CERT_ID=
# Multi-store OAuth client credentials (the app-id/cert-id aliases above remain for the legacy bridge).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
EBAY_MULTI_STORE_RU_NAME=
EBAY_RU_NAME=
EBAY_TOKEN_ENCRYPTION_KEY=GENERATE_WITH_OPENSSL_RAND_BASE64_32
EBAY_OAUTH_STATE_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
AUTOLISTER_ADMIN_USER_IDS=COMMA_SEPARATED_SUPABASE_USER_UUIDS
EBAY_LEGACY_OWNER_USER_ID=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_DEFAULT_CATEGORY_ID=
OPENAI_MODEL=gpt-6-astra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# AutoLister lead destination; digits only, international country code included.
WHATSAPP_LEAD_NUMBER=YOUR_INTERNATIONAL_NUMBER_DIGITS
LEAD_WEBHOOK_URL=

# Public legal details used by /impressum and /datenschutz at runtime.
# Fill with actual operator information before removing the visible Muster notice.
LEGAL_COMPANY=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_VAT_ID=

# Platform services
N8N_ENCRYPTION_KEY=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
UMAMI_DB_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
UMAMI_APP_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32

# Runtime defaults
NODE_ENV=production
REDIS_URL=redis://redis:6379/0

# External AI providers only; never expose these in frontend variables.
OPENAI_API_KEY=CHANGE_ME_SERVER_ONLY
ANTHROPIC_API_KEY=CHANGE_ME_SERVER_ONLY

NEXT_PUBLIC_APP_URL=https://autolister-app.de
