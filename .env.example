APP_TAG=latest
FRONTEND_IMAGE=ghcr.io/ahmetlee2-bot/autolister-frontend
API_IMAGE=ghcr.io/ahmetlee2-bot/autolister-api

# Existing local analysis service defaults
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
AUTONOW_DEFAULT_CITY=Hamburg

# Existing application / Supabase backend values
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVER_ONLY
RESEND_API_KEY=CHANGE_ME_SERVER_ONLY
RESEND_FROM_EMAIL=AutoLister <noreply@autolister-app.de>
OTP_PEPPER=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
CORS_ORIGIN=https://autolister-app.de
EBAY_BRIDGE_SHARED_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
RAINFOREST_API_KEY=
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_LEGACY_OWNER_USER_ID=

# AutoLister lead destination; digits only, international country code included.
WHATSAPP_LEAD_NUMBER=YOUR_INTERNATIONAL_NUMBER_DIGITS

# Public legal details used by /impressum and /datenschutz at runtime.
# Fill with actual operator information before removing the visible Muster notice.
LEGAL_COMPANY=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_VAT_ID=

# Platform services
N8N_ENCRYPTION_KEY=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
UMAMI_DB_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
UMAMI_APP_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32

# Runtime defaults
NODE_ENV=production
REDIS_URL=redis://redis:6379/0

# External AI providers only; never expose these in frontend variables.
OPENAI_API_KEY=CHANGE_ME_SERVER_ONLY
ANTHROPIC_API_KEY=CHANGE_ME_SERVER_ONLY
