{
  "manifest_version": 3,
  "name": "AutoLister: Amazon zu eBay 1-Klick Lister & Repricer",
  "version": "1.1.6",
  "description": "Amazon-Produkte mit 1 Klick auf eBay listen. Automatische Preis- und Bestandsprüfung, SEO-Titel und sofortige Margenberechnung.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.amazon.de/*",
    "https://*.joybuy.de/*",
    "https://*.media-amazon.com/*",
    "https://*.ssl-images-amazon.com/*",
    "https://images-na.ssl-images-amazon.com/*",
    "https://api.autolister-app.de/*",
    "https://autolister-app.de/*",
    "https://rdwqrygkkzzouiamrxwq.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AutoLister: Amazon-Produkt auf eBay listen",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.de/*"
      ],
      "js": [
        "seoProcessor.js",
        "identifierProcessor.js",
        "descriptionProcessor.js",
        "listing_builder.js",
        "amazon_parser.js",
        "amazonOrders.js",
        "content.js",
        "addressParser.js",
        "checkoutRunner.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.joybuy.de/*"
      ],
      "js": [
        "addressParser.js",
        "checkoutRunner.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://autolister-app.de/*",
        "https://*.autolister-app.de/*",
        "http://localhost/*",
        "http://localhost:*/*"
      ],
      "js": [
        "dashboardBridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
