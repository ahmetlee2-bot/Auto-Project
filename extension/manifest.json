{
  "manifest_version": 3,
  "name": "AutoLister: Multi-Supplier eBay Lister & Repricer",
  "version": "1.1.1",
  "description": "Amazon.de- und Joybuy.de-Produkte mit AutoLister für eBay vorbereiten. Preis- und Bestandsprüfung, SEO-Titel und Margenkalkulation.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.amazon.de/*",
    "https://*.media-amazon.com/*",
    "https://*.ssl-images-amazon.com/*",
    "https://images-na.ssl-images-amazon.com/*",
    "https://api.autolister-app.de/*",
    "https://autolister-app.de/*",
    "https://rdwqrygkkzzouiamrxwq.supabase.co/*",
    "https://*.joybuy.de/*",
    "https://*.joybuy.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AutoLister: Produkt auf eBay vorbereiten",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.de/*"
      ],
      "js": [
        "seoProcessor.js",
        "identifierProcessor.js",
        "descriptionProcessor.js",
        "listing_builder.js",
        "amazon_parser.js",
        "content.js",
        "amazonOrders.js",
        "syncToast.js"
      ],
      "run_at": "document_idle"
    },
    {
      "run_at": "document_idle",
      "matches": [
        "https://*.joybuy.de/*"
      ],
      "js": [
        "joybuy_content.js",
        "syncToast.js"
      ]
    },
    {
      "matches": [
        "https://autolister-app.de/*"
      ],
      "js": [
        "syncToast.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
