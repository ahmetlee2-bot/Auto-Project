NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_EBAY_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=https://autolister-app.de
# Server-only; never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Stripe hosted Checkout; configure the webhook for checkout.session.completed
# and checkout.session.async_payment_succeeded.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Optional server-only key for ASIN enrichment in the admin product depot.
# When omitted, the app makes one normal public-page request to Amazon.de/.com;
# if Amazon blocks it, the import fails safely and leaves stock unchanged.
RAINFOREST_API_KEY=
# Add authenticated Supabase user UUIDs allowed to manage shared pool and academy content.
AUTOLISTER_ADMIN_USER_IDS=
# eBay multi-store OAuth. Configure this exact RuName/callback in eBay Developer Console.
EBAY_ENV=production
EBAY_CLIENT_ID=YOUR_EBAY_CLIENT_ID
EBAY_CLIENT_SECRET=YOUR_EBAY_CLIENT_SECRET
EBAY_MULTI_STORE_RU_NAME=YOUR_EBAY_RU_NAME
# Generate with: openssl rand -base64 32
EBAY_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY
EBAY_OAUTH_STATE_SECRET=YOUR_RANDOM_STATE_SECRET
# Listing requirements can be set globally here or individually per store in the Dashboard.
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
CRON_SECRET=YOUR_LONG_RANDOM_CRON_SECRET
# Optional HTTPS 3PL adapter. The response must provide the real tracking number
# and a carrier code supported by eBay Fulfillment.
LOGISTICS_3PL_API_URL=
LOGISTICS_3PL_API_KEY=
# Tracking conversion provider; mock mode is for sandbox/demo use only.
TRACKING_PROVIDER_API_KEY=
TRACKING_PROVIDER_URL=
TRACKING_MOCK_MODE=false
WHATSAPP_LEAD_NUMBER=YOUR_INTERNATIONAL_NUMBER_DIGITS
# Optional HTTPS webhook that receives consented lead details as JSON.
LEAD_WEBHOOK_URL=

NEXT_PUBLIC_APP_URL=https://autolister-app.de
